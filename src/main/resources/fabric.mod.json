	},
	"mixins": [ "mtr_opt.mixins.json" ],
	"depends": {
		"fabricloader": ">=0.14.0",
		"fabric-api": "*",
		"minecraft": "1.19.4",
		"java": ">=17",
		"mtr": ">=4.0.5"
	}
}
